{
  "name": "AION SI Exchange Linux (simulation only)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "SI Exchange demo",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pytest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
